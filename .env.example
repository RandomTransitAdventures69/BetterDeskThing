# Copy these keys into .env (or run: python setup_wizard.py).
# Never commit .env - it contains credentials.

# Spotify (https://developer.spotify.com/dashboard)
SPOTIPY_CLIENT_ID=your_spotify_client_id
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8080/callback

# MBTA v3 API (https://api-v3.mbta.com/docs)
MBTA_API_KEY=your_mbta_api_key

# Weather
WEATHER_LABEL=Keystone, FL
WEATHER_LAT=28.6314
WEATHER_LON=-82.2995
WEATHER_UNITS=fahrenheit
WEATHER_TIMEZONE=America/New_York
FORECAST_DAYS=5
WEATHER_REFRESH_MINUTES=15

# Transit
TRANSIT_DEFAULT_STOP=place-WML-0081
TRANSIT_REFRESH_SECONDS=30
TRANSIT_DEPARTURE_LIMIT=10

# Spotify polling
SPOTIFY_POLL_SECONDS=2

# Server / interface
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
START_PAGE=weather
UI_THEME=classic
SHOW_STATUSBAR=true
